rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sólo entran las cuentas registradas: un documento allowlist/{mail en minúsculas}.
    // El registro lo hace el servidor la primera vez que alguien entra (app/api/access); desde la app
    // no se puede leer ni modificar. Las API routes revisan lo mismo (lib/firebase/admin.ts).
    function isAllowed() {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // Cada usuario sólo puede leer y escribir lo suyo.
    // El cron usa el Admin SDK, que no pasa por estas reglas.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && isAllowed();
    }

    // Validación de lo que se guarda. La app está abierta a cualquier cuenta de Google: sólo se aceptan los
    // campos que la app escribe (más los viejos que todavía se leen) y los textos tienen tope, así nadie usa su
    // espacio como disco. Se valida el documento completo después de escribir: un update parcial también tiene
    // que dejarlo bien, incluidos los campos que agrega el cron (lastNotifiedAt/lastNotifiedStatus).
    // Todos los campos pueden faltar o ser null (documentos viejos); si están, tienen que ser del tipo.
    function optText(d, f, max) {
      return d.get(f, null) == null || (d[f] is string && d[f].size() <= max);
    }

    function optNum(d, f) {
      return d.get(f, null) == null || d[f] is number;
    }

    function optBool(d, f) {
      return d.get(f, null) == null || d[f] is bool;
    }

    function optTime(d, f) {
      return d.get(f, null) == null || d[f] is timestamp;
    }

    // Lista de ids (strings) con tope de cantidad y de largo total.
    function optIds(d, f, maxItems) {
      return d.get(f, null) == null
        || (d[f] is list && d[f].size() <= maxItems && d[f].join(',').size() <= maxItems * 100);
    }

    // { amount, unit }: "6 meses", "1 año".
    function optInterval(d, f) {
      return d.get(f, null) == null
        || (d[f] is map && d[f].keys().hasOnly(['amount', 'unit']) && optNum(d[f], 'amount') && optText(d[f], 'unit', 20));
    }

    // Ajustes (users/{uid}): lo crea la app la primera vez con DEFAULT_SETTINGS.
    function validSettings(d) {
      return d.keys().hasOnly(['reminder', 'timezone', 'createdAt'])
        && (d.get('reminder', null) == null
          || (d.reminder is map && d.reminder.keys().hasOnly(['enabled', 'weekday'])
            && optBool(d.reminder, 'enabled') && optNum(d.reminder, 'weekday')))
        && optText(d, 'timezone', 100)
        && optTime(d, 'createdAt');
    }

    // Perfil de un miembro en memberProfiles: el mail con el que entró y su nombre de Google.
    function validProfile(p) {
      return p is map && p.keys().hasOnly(['email', 'name']) && optText(p, 'email', 320) && optText(p, 'name', 200);
    }

    // memberUids son hasta 2 uids distintos (como en members, se acota el largo de la lista unida). memberProfiles
    // tiene un perfil por cada uno y ninguna otra clave; sin bucles, se valida el perfil de cada posición de la lista.
    // Los dos pueden faltar: los autos creados con la versión anterior de la PWA no los tienen.
    function validMembers(d) {
      let uids = d.get('memberUids', []);
      let profiles = d.get('memberProfiles', {});
      return uids is list && uids.size() <= 2 && uids.join(',').size() <= 2 * 128
        && uids.toSet().size() == uids.size()
        && profiles is map && profiles.keys().toSet() == uids.toSet()
        && (uids.size() < 1 || validProfile(profiles[uids[0]]))
        && (uids.size() < 2 || validProfile(profiles[uids[1]]));
    }

    // ownerUid, ownerName, members, memberUids y memberProfiles sólo los guarda cars/{carId}; members son hasta 2
    // mails en minúscula (lo viejo, hasta #66). Las reglas no tienen bucles: como en optIds, se acota la cantidad y el
    // largo de la lista unida (join falla, y la regla deniega, si hay algo que no es texto), y la lista unida tiene
    // que estar en minúscula. Los miembros por uid los valida validMembers.
    function validCar(d) {
      return d.keys().hasOnly([
          'brand', 'model', 'version', 'year', 'plate', 'fuelTypes', 'currentKm', 'kmUpdatedAt',
          'avgKmPerDay', 'photoUrl', 'photoPublicId', 'createdAt', 'ownerUid', 'ownerName', 'members',
          'memberUids', 'memberProfiles'])
        && optText(d, 'ownerUid', 128) && optText(d, 'ownerName', 200)
        && validMembers(d)
        && (d.get('members', null) == null
          || (d.members is list && d.members.size() <= 2 && d.members.join(',').size() <= 2 * 320
            && d.members.join(',') == d.members.join(',').lower()))
        && optText(d, 'brand', 200) && optText(d, 'model', 200) && optText(d, 'version', 200)
        && optNum(d, 'year') && optText(d, 'plate', 50)
        && (d.get('fuelTypes', null) == null || (d.fuelTypes is list && d.fuelTypes.hasOnly(['nafta', 'gnc', 'gasoil'])))
        && optNum(d, 'currentKm') && optTime(d, 'kmUpdatedAt') && optNum(d, 'avgKmPerDay')
        && optText(d, 'photoUrl', 2000) && optText(d, 'photoPublicId', 500)
        && optTime(d, 'createdAt');
    }

    // intervalMonths es el formato viejo del intervalo (lib/parse.ts lo sigue leyendo).
    // El nombre y el título de un trabajo van y vienen (job-form precarga el título con el nombre, y
    // "Volver al taller: <título>" arma un nombre), así que tienen el mismo tope, holgado.
    // lastDoneKmEstimated dice que lastDoneKm se estimó con las lecturas (un trabajo sin km); falta en los viejos.
    // baseKm y baseDate son la "última vez" que carga el dueño; lastDone*, lastDoneJobId y completedByJobId son la
    // proyección que sale de los trabajos aprobados (lastDoneJobId: el trabajo que manda; completedByJobId: el que
    // cumplió un recordatorio de una vez). Todos faltan en lo que escribe la versión anterior de la PWA.
    function validRule(d) {
      return d.keys().hasOnly([
          'carId', 'name', 'intervalKm', 'intervalTime', 'intervalMonths', 'repeat', 'baseKm', 'baseDate',
          'lastDoneKm', 'lastDoneKmEstimated', 'lastDoneDate', 'lastDoneJobId', 'completedByJobId',
          'warnKm', 'warnDays', 'lastNotifiedAt', 'lastNotifiedStatus'])
        && optText(d, 'carId', 100) && optText(d, 'name', 500)
        && optNum(d, 'intervalKm') && optInterval(d, 'intervalTime') && optNum(d, 'intervalMonths')
        && optBool(d, 'repeat') && optNum(d, 'baseKm') && optText(d, 'baseDate', 30)
        && optNum(d, 'lastDoneKm') && optBool(d, 'lastDoneKmEstimated') && optText(d, 'lastDoneDate', 30)
        && optText(d, 'lastDoneJobId', 100) && optText(d, 'completedByJobId', 100)
        && optNum(d, 'warnKm') && optNum(d, 'warnDays')
        && optTime(d, 'lastNotifiedAt') && optText(d, 'lastNotifiedStatus', 20);
    }

    // createdBy, createdByName, status, reviewedAt y revision los guarda cars/{carId}/jobs; quién puede cambiarlos lo
    // decide ese match. reviewedAt es cuándo el dueño aprobó o rechazó el trabajo de un miembro; revision, la versión
    // del trabajo (falta en lo que escribe la versión 1.4.1 de la PWA, y se lee como 0).
    function validJob(d) {
      return d.keys().hasOnly([
          'carId', 'date', 'km', 'title', 'category', 'cost', 'workshop', 'notes', 'ruleIds', 'createdAt',
          'createdBy', 'createdByName', 'status', 'reviewedAt', 'revision'])
        && optText(d, 'createdBy', 128) && optText(d, 'createdByName', 200)
        && d.get('status', 'approved') in ['approved', 'pending', 'rejected'] && optTime(d, 'reviewedAt')
        && optNum(d, 'revision')
        && optText(d, 'carId', 100) && optText(d, 'date', 30) && optNum(d, 'km')
        && optText(d, 'title', 500) && optText(d, 'category', 50) && optNum(d, 'cost')
        && optText(d, 'workshop', 200) && optText(d, 'notes', 5000)
        && optIds(d, 'ruleIds', 200) && optTime(d, 'createdAt');
    }

    function validFuel(d) {
      return d.keys().hasOnly([
          'carId', 'date', 'km', 'fuelType', 'grade', 'quantity', 'unitPrice', 'total', 'fullTank',
          'station', 'createdAt', 'createdBy', 'createdByName'])
        && optText(d, 'createdBy', 128) && optText(d, 'createdByName', 200)
        && optText(d, 'carId', 100) && optText(d, 'date', 30) && optNum(d, 'km')
        && optText(d, 'fuelType', 20) && optText(d, 'grade', 20)
        && optNum(d, 'quantity') && optNum(d, 'unitPrice') && optNum(d, 'total')
        && optBool(d, 'fullTank') && optText(d, 'station', 200) && optTime(d, 'createdAt');
    }

    // sourceId es el id de la carga o del trabajo del que salió la lectura (lo valida linkedOk). createdAt es cuándo
    // se cargó en la app (lo usan los logros); falta en las viejas.
    function validReading(d) {
      return d.keys().hasOnly(['carId', 'km', 'date', 'source', 'sourceId', 'createdBy', 'createdByName', 'createdAt'])
        && optText(d, 'createdBy', 128) && optText(d, 'createdByName', 200)
        && optText(d, 'carId', 100) && optNum(d, 'km') && optTime(d, 'date') && optText(d, 'source', 20)
        && optText(d, 'sourceId', 100) && optTime(d, 'createdAt');
    }

    // Ruta del registro del que salió una lectura vinculada. source es 'fuel' o 'job', pero la colección de los
    // trabajos es 'jobs'.
    function linkedParent(carId, d) {
      return /databases/$(database)/documents/cars/$(carId)/$(d.source == 'job' ? 'jobs' : 'fuel')/$(d.sourceId);
    }

    // Una lectura con sourceId sale de una carga o un trabajo: su id es el determinístico ({source}-{sourceId}) y el
    // registro existe después del pedido (se escriben en el mismo batch). Sin sourceId es manual, de alta o vieja
    // (la versión anterior de la PWA las escribe así), y se acepta como siempre.
    function linkedOk(carId, readingId, d) {
      return d.get('sourceId', null) == null
        || (d.get('source', null) in ['fuel', 'job']
          && readingId == d.source + '-' + d.sourceId
          && existsAfter(linkedParent(carId, d)));
    }

    // Si un miembro puede borrar una lectura suya: sin sourceId, siempre; vinculada, sólo junto con su registro o
    // cuando el registro se queda sin km. El || corta antes del getAfter si el registro ya no existe.
    function linkedReleased(carId, d) {
      return d.get('sourceId', null) == null
        || !existsAfter(linkedParent(carId, d))
        || getAfter(linkedParent(carId, d)).data.get('km', null) == null;
    }

    // Lo que devuelve PushSubscription.toJSON(): sin endpoint https y claves, el cron no puede enviar.
    // El campo "keys" va entre corchetes para no confundirlo con el método keys().
    function validPushSubscription(d) {
      return d.keys().hasOnly(['endpoint', 'keys', 'userAgent', 'createdAt'])
        && d.endpoint is string && d.endpoint.size() <= 2000 && d.endpoint.matches('https://.+')
        && d['keys'] is map && d['keys'].keys().hasOnly(['p256dh', 'auth']) && d['keys'].keys().hasAll(['p256dh', 'auth'])
        && d['keys'].p256dh is string && d['keys'].p256dh.size() <= 200
        && d['keys'].auth is string && d['keys'].auth.size() <= 200
        && optText(d, 'userAgent', 1000) && optTime(d, 'createdAt');
    }

    function validAchievement(d) {
      return d.keys().hasOnly(['carId', 'unlockedAt', 'celebratedAt'])
        && optText(d, 'carId', 100) && optTime(d, 'unlockedAt') && optTime(d, 'celebratedAt');
    }

    // Mail canónico de un mail en minúscula (mismo cálculo que canonicalEmail en lib/sharing.ts): en Gmail (o
    // googlemail.com) sin puntos ni "+algo" antes de la arroba, y con dominio gmail.com. Los demás dominios quedan
    // como vienen. replace cambia todas las coincidencias.
    function canonicalEmail(e) {
      let parts = e.split('@');
      return parts[1] in ['gmail.com', 'googlemail.com']
        ? parts[0].split('[+]')[0].replace('[.]', '') + '@gmail.com'
        : e;
    }

    // Mail canónico del login: con lo que se compara el emailKey de una invitación.
    function myEmailKey() {
      return canonicalEmail(request.auth.token.email.lower());
    }

    // Invitación (invites/{carId}_{emailKey}): email va como lo escribió el dueño, en minúscula, y emailKey es su mail
    // canónico. carLabel es lo que ve el invitado del auto antes de aceptar, sin poder leerlo.
    function validInvite(d) {
      return d.keys().hasOnly([
          'carId', 'ownerUid', 'ownerName', 'carLabel', 'email', 'emailKey', 'status', 'createdAt', 'expiresAt',
          'respondedAt', 'acceptedUid'])
        && d.carId is string && d.carId.size() <= 100
        && d.ownerUid is string && d.ownerUid.size() <= 128
        && optText(d, 'ownerName', 200) && optText(d, 'carLabel', 500)
        && d.email is string && d.email.size() <= 320 && d.email == d.email.lower()
        && d.emailKey is string && d.emailKey == canonicalEmail(d.email)
        && d.status in ['pending', 'accepted', 'declined', 'revoked']
        && d.createdAt is timestamp && d.expiresAt is timestamp
        && optTime(d, 'respondedAt') && optText(d, 'acceptedUid', 128);
    }

    // Una invitación nueva, o mandada de nuevo, como la escribe inviteMember: la manda el dueño del auto a su nombre,
    // el id es carId + '_' + emailKey, está pendiente y sin respuesta, vence en 15 días como mucho y no es para el
    // mail del propio dueño.
    function freshInvite(inviteId) {
      let d = request.resource.data;
      return validInvite(d) && isOwner(d.ownerUid) && ownsCar(d.carId)
        && inviteId == d.carId + '_' + d.emailKey
        && d.status == 'pending'
        && d.expiresAt <= request.time + duration.value(15, 'd')
        && d.emailKey != myEmailKey()
        && d.get('respondedAt', null) == null && d.get('acceptedUid', null) == null;
    }

    // Si el dueño puede volver a mandar una invitación que ya existe (el id es fijo): la rechazaron o la canceló,
    // venció sin respuesta, o la aceptaron y esa cuenta ya no es miembro del auto (salió o la sacaron).
    function reinvitable() {
      let s = resource.data.status;
      return s in ['declined', 'revoked']
        || (s == 'pending' && request.time >= resource.data.expiresAt)
        || (s == 'accepted' && !(resource.data.acceptedUid in
          get(/databases/$(database)/documents/cars/$(resource.data.carId)).data.get('memberUids', [])));
    }

    // Mandar de nuevo una invitación: la misma que crearía freshInvite, para el mismo auto, dueño y mail.
    function ownerResend(inviteId) {
      return isOwner(resource.data.ownerUid) && reinvitable() && freshInvite(inviteId)
        && request.resource.data.carId == resource.data.carId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.email == resource.data.email
        && request.resource.data.emailKey == resource.data.emailKey;
    }

    // El dueño cancela una invitación (revokeInvite): sólo una pendiente, y sólo cambia el estado a revoked.
    function ownerRevoke() {
      return isOwner(resource.data.ownerUid) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'revoked';
    }

    // El invitado responde (acceptInvite, declineInvite): una invitación para su mail canónico, pendiente y sin vencer.
    // Cambia el estado a accepted o declined, respondedAt (la hora del pedido) y acceptedUid (su uid). Si acepta, el
    // auto tiene que quedar con su uid en memberUids en el mismo batch (memberJoin).
    function inviteeResponse() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null && isAllowed() && before.emailKey == myEmailKey()
        && before.status == 'pending' && request.time < before.expiresAt
        && after.diff(before).affectedKeys().hasOnly(['status', 'respondedAt', 'acceptedUid'])
        && after.status in ['accepted', 'declined']
        && after.respondedAt == request.time
        && after.acceptedUid == request.auth.uid
        && (after.status == 'declined'
          || request.auth.uid in getAfter(/databases/$(database)/documents/cars/$(before.carId)).data.get('memberUids', []));
    }

    // Dueño del auto según el documento antes del pedido: lo usan leer y borrar. En un borrado en lote, el
    // auto se borra en el último paso, así que todavía existe cuando se evalúan los hijos.
    function ownsCar(carId) {
      return isOwner(get(/databases/$(database)/documents/cars/$(carId)).data.ownerUid);
    }

    // Dueño del auto según el documento después del pedido: lo usan crear y editar. createCar crea el auto y su
    // primera lectura en el mismo batch, y con get() el auto todavía no existe para la regla de la lectura.
    function ownsCarAfter(carId) {
      return isOwner(getAfter(/databases/$(database)/documents/cars/$(carId)).data.ownerUid);
    }

    // Mail de quien pide, en minúscula: así se guarda en members y así lo busca la consulta de autos compartidos
    // (where('members', 'array-contains', mail en minúscula)). Tiene que ser el mismo valor para que Firestore
    // pueda probar la regla de lectura con esa consulta.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Miembro de un auto, según sus datos: una cuenta registrada cuyo uid está en memberUids (aceptó una invitación)
    // o, hasta #66, cuyo mail está en members. Si al auto le falta uno de los dos campos, esa mitad da error y el ||
    // decide con la otra. Así se prueban las dos consultas de autos compartidos (por memberUids y por members).
    function isMember(car) {
      return request.auth != null && isAllowed()
        && (request.auth.uid in car.memberUids || myEmail() in car.members);
    }

    // Miembro del auto según el documento antes del pedido (leer y borrar), como ownsCar.
    function memberOfCar(carId) {
      return isMember(get(/databases/$(database)/documents/cars/$(carId)).data);
    }

    // Miembro del auto según el documento después del pedido (crear y editar), como ownsCarAfter.
    function memberOfCarAfter(carId) {
      return isMember(getAfter(/databases/$(database)/documents/cars/$(carId)).data);
    }

    // Salir de un auto al que entré por invitación (leaveCar): saca mi uid de memberUids, mi perfil de memberProfiles
    // y, si está, mi mail de members, y nada más.
    function memberLeave() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth.uid in before.get('memberUids', [])
        && after.diff(before).affectedKeys().hasOnly(['memberUids', 'memberProfiles', 'members'])
        && after.get('memberUids', []).toSet() == before.get('memberUids', []).toSet().difference([request.auth.uid].toSet())
        && after.get('memberProfiles', {}).diff(before.get('memberProfiles', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('members', []).toSet() == before.get('members', []).toSet().difference([myEmail()].toSet());
    }

    // Salir como lo hace la versión anterior de la PWA: sacar sólo mi mail de members. Vale únicamente si mi uid no está
    // en memberUids; si no, seguiría viendo el auto por el uid creyendo que salió.
    function legacyMemberLeave() {
      return !(request.auth.uid in resource.data.get('memberUids', []))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.toSet() == resource.data.members.toSet().difference([myEmail()].toSet());
    }

    // Lo único que un miembro cambia del auto: el km (al cargar km o una carga, o cuando la app lo corrige sola) o
    // salir (memberLeave, o legacyMemberLeave desde la versión anterior de la PWA).
    function memberCarUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentKm', 'kmUpdatedAt', 'avgKmPerDay'])
        || memberLeave()
        || legacyMemberLeave();
    }

    // Un invitado se suma al auto (acceptInvite): sólo agrega su uid al final de memberUids (con 2 como mucho) y su
    // perfil a memberProfiles, y en el mismo batch su invitación (carId + '_' + su mail canónico) pasa de pending
    // (antes del pedido) a accepted con su uid (después). Sin una invitación pendiente para su mail no se puede sumar.
    // El tope de 2 frena al tercero aunque se acepten dos invitaciones a la vez.
    function memberJoin(carId) {
      let before = resource.data;
      let after = request.resource.data;
      let uids = before.get('memberUids', []);
      let invite = /databases/$(database)/documents/invites/$(carId + '_' + myEmailKey());
      return request.auth != null && isAllowed()
        && after.diff(before).affectedKeys().hasOnly(['memberUids', 'memberProfiles'])
        && !(request.auth.uid in uids)
        && after.memberUids == uids.concat([request.auth.uid])
        && after.memberUids.size() <= 2
        && after.memberProfiles.diff(before.get('memberProfiles', {})).affectedKeys() == [request.auth.uid].toSet()
        && get(invite).data.status == 'pending'
        && getAfter(invite).data.status == 'accepted'
        && getAfter(invite).data.acceptedUid == request.auth.uid;
    }

    // Lo que el dueño cambia de los miembros: sólo sacar. No suma mails a members (la versión anterior de la PWA
    // compartía así, sin que la otra persona aceptara) ni uids a memberUids, ni agrega o cambia perfiles: al auto se
    // entra sólo aceptando una invitación (memberJoin).
    function ownerMembersUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let profiles = after.get('memberProfiles', {}).diff(before.get('memberProfiles', {}));
      return before.get('members', []).toSet().hasAll(after.get('members', []))
        && before.get('memberUids', []).toSet().hasAll(after.get('memberUids', []))
        && profiles.addedKeys().size() == 0 && profiles.changedKeys().size() == 0;
    }

    // Lo que el dueño cambia de un trabajo. Editar sin revisarlo (mismo estado y mismo reviewedAt) no tiene condiciones
    // extra. Revisarlo (aprobar o rechazar: cambia el estado o reviewedAt) sólo vale para pasar un trabajo pendiente a
    // approved o rejected, o uno aprobado a rejected, y con la revisión que vio el dueño: si el miembro lo editó
    // mientras tanto, su revision subió y se deniega. Así no se aprueba una versión vieja, ni algo ya aprobado o
    // rechazado (dos veces o desde dos dispositivos), ni un rechazado que el miembro no volvió a mandar. Sin status
    // cuenta como approved y sin revision como 0: la versión 1.4.1 de la PWA no la manda, así que su update deja la
    // guardada y su aprobación pasa.
    function ownerJobUpdate() {
      let before = resource.data.get('status', 'approved');
      let after = request.resource.data.get('status', 'approved');
      let reviewing = after != before
        || request.resource.data.get('reviewedAt', null) != resource.data.get('reviewedAt', null);
      return !reviewing
        || (((before == 'pending' && after in ['approved', 'rejected']) || (before == 'approved' && after == 'rejected'))
          && request.resource.data.get('revision', 0) == resource.data.get('revision', 0));
    }

    // Revisión que deja el miembro al editar su trabajo: la anterior + 1 (sin revision cuenta como 0). La versión 1.4.1
    // de la PWA no la manda, así que un miembro con esa versión no puede editar sus trabajos hasta recargar la app.
    function memberJobRevision() {
      let before = resource.data.get('revision', 0);
      let after = request.resource.data.get('revision', 0);
      return after == before + 1;
    }

    // Rutas: sólo las que usa la app (lib/db.ts). Cualquier otra queda negada.
    // Los autos son documentos de primer nivel con dueño y hasta 2 miembros. Leen el dueño y los miembros: el
    // cliente pide los suyos por ownerUid y los compartidos por memberUids y, hasta #66, por members, que es lo que
    // piden estas reglas. El dueño crea, borra y edita el auto, y de los miembros sólo saca (ownerMembersUpdate); el
    // miembro sólo cambia el km o sale (memberCarUpdate), y un invitado se suma aceptando (memberJoin). Los hijos
    // guardan el carId de la ruta, y createdBy no cambia al editar.
    match /cars/{carId} {
      allow read: if isOwner(resource.data.ownerUid) || isMember(resource.data);
      allow delete: if isOwner(resource.data.ownerUid);
      allow create: if isOwner(request.resource.data.ownerUid) && validCar(request.resource.data);
      allow update: if validCar(request.resource.data)
        && ((isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid
            && ownerMembersUpdate())
          || (isMember(resource.data) && memberCarUpdate())
          || memberJoin(carId));

      // El plan de mantenimiento es del dueño: los miembros sólo lo leen.
      match /rules/{ruleId} {
        allow read: if ownsCar(carId) || memberOfCar(carId);
        allow delete: if ownsCar(carId);
        allow create, update: if ownsCarAfter(carId) && validRule(request.resource.data)
          && request.resource.data.carId == carId;
      }

      // El dueño crea con cualquier autor, estado y revisión (así "Deshacer" devuelve el trabajo de un miembro como
      // estaba), edita cualquier trabajo y lo revisa según ownerJobUpdate. El miembro crea a su nombre y nunca approved
      // (rejected es para "Deshacer"), y edita o borra sólo un trabajo suyo pendiente o rechazado: al editarlo vuelve
      // a pending, no toca reviewedAt y sube revision en 1 (memberJobRevision).
      match /jobs/{jobId} {
        allow read: if ownsCar(carId) || memberOfCar(carId);
        allow delete: if ownsCar(carId)
          || (memberOfCar(carId) && resource.data.get('createdBy', null) == request.auth.uid
            && resource.data.get('status', 'approved') != 'approved');
        allow create: if validJob(request.resource.data) && request.resource.data.carId == carId
          && (ownsCarAfter(carId)
            || (memberOfCarAfter(carId) && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.get('status', 'approved') in ['pending', 'rejected']));
        allow update: if validJob(request.resource.data) && request.resource.data.carId == carId
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && ((ownsCarAfter(carId) && ownerJobUpdate())
            || (memberOfCarAfter(carId) && resource.data.get('createdBy', null) == request.auth.uid
              && resource.data.get('status', 'approved') in ['pending', 'rejected']
              && request.resource.data.get('status', 'approved') == 'pending'
              && request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null)
              && memberJobRevision()));
      }

      // El dueño crea con cualquier autor ("Deshacer" de algo de un miembro), edita y borra todo. El miembro crea a
      // su nombre y edita o borra sólo lo suyo.
      match /fuel/{fuelId} {
        allow read: if ownsCar(carId) || memberOfCar(carId);
        allow delete: if ownsCar(carId)
          || (memberOfCar(carId) && resource.data.get('createdBy', null) == request.auth.uid);
        allow create: if validFuel(request.resource.data) && request.resource.data.carId == carId
          && (ownsCarAfter(carId) || (memberOfCarAfter(carId) && request.resource.data.createdBy == request.auth.uid));
        allow update: if validFuel(request.resource.data) && request.resource.data.carId == carId
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && (ownsCarAfter(carId) || (memberOfCarAfter(carId) && resource.data.get('createdBy', null) == request.auth.uid));
      }

      // Los mismos permisos que las cargas, más el vínculo con la carga o el trabajo (linkedOk), que no cambia al
      // editar. Una lectura vinculada va a nombre de quien cargó el registro, así que el dueño puede escribir la de
      // la carga de un miembro sin cambiar createdBy. El dueño borra cualquier lectura sin consultar el registro
      // (deleteCar borra de a 450 y pasaría el tope de llamadas por pedido); el miembro, sólo las suyas y, si son
      // vinculadas, cuando el registro ya no existe o no tiene km (linkedReleased). Borrar una lectura que no existe
      // no tiene efecto y se acepta, para no tirar abajo el batch de la carga o el trabajo.
      match /odometer/{readingId} {
        allow read: if ownsCar(carId) || memberOfCar(carId);
        allow delete: if ownsCar(carId)
          || (memberOfCar(carId) && (resource == null
            || (resource.data.get('createdBy', null) == request.auth.uid && linkedReleased(carId, resource.data))));
        allow create: if validReading(request.resource.data) && request.resource.data.carId == carId
          && linkedOk(carId, readingId, request.resource.data)
          && (ownsCarAfter(carId) || (memberOfCarAfter(carId) && request.resource.data.createdBy == request.auth.uid));
        allow update: if validReading(request.resource.data) && request.resource.data.carId == carId
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && request.resource.data.get('sourceId', null) == resource.data.get('sourceId', null)
          && linkedOk(carId, readingId, request.resource.data)
          && (ownsCarAfter(carId) || (memberOfCarAfter(carId) && resource.data.get('createdBy', null) == request.auth.uid));
      }
    }

    // Invitaciones a compartir un auto. Las leen el dueño (las pide por ownerUid) y el invitado (las pide por emailKey,
    // su mail canónico). El dueño las crea (freshInvite), las vuelve a mandar (ownerResend), cancela las pendientes
    // (ownerRevoke) y las borra con el auto; el invitado sólo las responde (inviteeResponse).
    match /invites/{inviteId} {
      allow read: if isOwner(resource.data.ownerUid)
        || (request.auth != null && isAllowed() && resource.data.emailKey == myEmailKey());
      allow delete: if isOwner(resource.data.ownerUid);
      allow create: if freshInvite(inviteId);
      allow update: if validInvite(request.resource.data)
        && (ownerResend(inviteId) || ownerRevoke() || inviteeResponse());
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings(request.resource.data);

      match /cars/{carId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCar(request.resource.data);
      }

      match /rules/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRule(request.resource.data);
      }

      match /jobs/{jobId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validJob(request.resource.data);
      }

      match /fuel/{fuelId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFuel(request.resource.data);
      }

      match /odometer/{readingId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReading(request.resource.data);
      }

      // El id es el SHA-256 (hex) del endpoint.
      match /pushSubscriptions/{subId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && subId.matches('[0-9a-f]{64}')
          && validPushSubscription(request.resource.data);
      }

      // El id es el del logro (lib/achievements.ts).
      match /achievements/{achievementId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && achievementId.size() <= 100
          && validAchievement(request.resource.data);
      }
    }
  }
}
